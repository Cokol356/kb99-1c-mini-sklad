#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Для Каждого Строка Из Товары Цикл
		Строка.Сумма = Строка.Цена * Строка.Количество;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ПродажиТоваров.Записывать = Истина;

	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = Строка.Товар;
		Движение.Количество = Строка.Количество;

		Продажа = Движения.ПродажиТоваров.Добавить();
		Продажа.Период = Дата;
		Продажа.Товар = Строка.Товар;
		Продажа.Контрагент = Контрагент;
		Продажа.Количество = Строка.Количество;
		Продажа.Сумма = Строка.Сумма;
	КонецЦикла;

	// Записываем движения, чтобы запрос видел остаток с учётом этого документа
	Движения.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Граница, Товар В (&МассивТоваров)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("МассивТоваров", Товары.ВыгрузитьКолонку("Товар"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не хватает товара «" + Строка(Выборка.Товар) + "»: остаток после проведения " + Строка(Выборка.КоличествоОстаток);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти